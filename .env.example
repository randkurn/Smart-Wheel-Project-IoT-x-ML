# Salin ke .env lalu isi. File .env tidak ikut di-commit.
# Sumber data dashboard: simulator | mqtt | firebase
VITE_DATA_SOURCE=simulator

# Firebase (diisi tim Database & Cloud saat Fase 1)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_DEVICE_ID=smartwheel-01

# MQTT over WebSocket (sumber "mqtt") — bisa juga diatur dari halaman Setting
VITE_MQTT_URL=ws://localhost:9001
VITE_MQTT_USERNAME=
VITE_MQTT_PASSWORD=
VITE_MQTT_TOPIC_PREFIX=smartwheel
